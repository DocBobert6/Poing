<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 3: cover art downloads only on Wi-Fi; the gate needs
         to know the active network. Normal permission, no runtime
         request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- RA login fix (2026-11-12): the RetroAchievements login
         failed on Robert's device with "Could not reach the
         RetroAchievements server" — the app declared no INTERNET
         permission at all, so every socket open failed with a
         permission denial before the request left the phone. The
         server was up and the phone had Wi-Fi; the app simply was
         not allowed to open a socket. No network feature in the
         app had ever worked on device (login, leaderboards,
         rich-presence pings). Normal permission, no runtime
         request. ManifestPermissionsTest fails if this is ever
         removed again. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 6 (item 7): haptics — the D-pad and A/B clicks.
         Normal permission, no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 6 (item 10c): the GB Camera — the phone's camera
         feeding the Game Boy Camera game. Dangerous permission:
         asked for at runtime, once per game, only when the game
         requests an image; without it the game keeps a white
         image. The feature is not required, so the app installs
         on camera-less devices too (the camera just stays off). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- In-app updater (Step 2 of the alpha, 2026-11-15): the
         app installs its own updates through the system
         installer. REQUEST_INSTALL_PACKAGES is the declaration;
         the user grants "install unknown apps" per app in
         Settings, which the updater directs them to when the
         grant is missing. ManifestPermissionsTest pins this. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poing">
        <!-- In-app updater (2026-11-15): the downloaded APK is
             handed to the system installer through this
             provider, so no file path ever leaves the app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- configChanges: later phases force landscape for the game
             screen; declaring this now pins the rule from Phase 1 so
             a rotation can never recreate the activity and lose state
             (HowlingDog Phase 2 device bug: Start flashed back to a
             fresh setup screen). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.Poing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

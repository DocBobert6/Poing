<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 3: cover art downloads only on Wi-Fi; the gate needs
         to know the active network. Normal permission, no runtime
         request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 6 (item 7): haptics — the D-pad and A/B clicks.
         Normal permission, no runtime request. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 6 (item 10c): the GB Camera — the phone's camera
         feeding the Game Boy Camera game. Dangerous permission:
         asked for at runtime, once per game, only when the game
         requests an image; without it the game keeps a white
         image. The feature is not required, so the app installs
         on camera-less devices too (the camera just stays off). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poing">
        <!-- configChanges: later phases force landscape for the game
             screen; declaring this now pins the rule from Phase 1 so
             a rotation can never recreate the activity and lose state
             (HowlingDog Phase 2 device bug: Start flashed back to a
             fresh setup screen). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.Poing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

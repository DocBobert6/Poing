<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon — the supplied icon, cropped to the tile's true
  bounding box (pixel scan, including the gold ornament rings:
  x[405,1002] y[80,686] in icon/poing-icon.jpg, centre 703.5,383),
  with even 12px margins, composed at 66% of the 108dp canvas
  (285px of 432px) and centred on transparent padding — inside
  the safe zone, so no launcher mask (square, circle, squircle)
  touches the tile, the L/R shoulders, or the gold ornament. The
  full-bleed Phase 5 version clipped the shoulders and ornament
  under the circular mask; this is the fix. The background is
  near-black and only shows around the tile.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon — the approved wordmark (Robert, 2026-11-14):
  "Poing!" in the app's own DotGothic16 with the gold ring,
  from icon/poing-icon.png (the first wordmark concept rebuilt
  with the real font). The artwork is scaled so the gold ring
  (896px wide in the 1024 source) sits at 260px of the 432px
  foreground — inside the 66dp safe zone of the 108dp canvas —
  so no launcher mask (square, circle, squircle) touches the
  ring or the text; the same scaled master feeds the legacy
  mipmaps, so the look is consistent at every density. The
  background is solid black, matching the artwork's own
  background. The supplied icon/poing-icon.jpg is untouched.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
